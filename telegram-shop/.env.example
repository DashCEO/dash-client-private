# Copy this file to .env and paste the token from @BotFather.
# Keep .env on the machine running the bot.
BOT_TOKEN=

# Private list of accepted promo codes, separated by commas.
PROMO_CODES=

# Set to 1 only for Telegram's separate test environment.
BOT_TEST_MODE=0

